# Server Environment Variables — copy this to .env and fill in your values
PORT=5000
NODE_ENV=development

# Google Gemini API Key (required for AI recruiter critique & bullet rewrites)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (required for history persistence)
# Get yours at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Client URL — used for CORS (your Netlify URL in production, leave empty for local dev)
CLIENT_URL=
